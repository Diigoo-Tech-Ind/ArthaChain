{
    "dashboard": {
        "title": "ArthaChain Node Overview",
        "tags": [
            "arthachain",
            "node",
            "overview"
        ],
        "timezone": "browser",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "Node Status",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "up{job=\"arthachain-node\"}",
                        "legendFormat": "Node Status",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "mappings": [
                            {
                                "type": "value",
                                "value": "0",
                                "text": "DOWN",
                                "color": "red"
                            },
                            {
                                "type": "value",
                                "value": "1",
                                "text": "UP",
                                "color": "green"
                            }
                        ]
                    }
                }
            },
            {
                "id": 2,
                "title": "Uptime",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 6,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "time() - process_start_time_seconds{job=\"arthachain-node\"}",
                        "legendFormat": "Uptime",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "s"
                    }
                }
            },
            {
                "id": 3,
                "title": "Peer Count",
                "type": "gauge",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "arthachain_peer_count",
                        "legendFormat": "Peers",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "min": 0,
                        "max": 50,
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 3,
                                    "color": "yellow"
                                },
                                {
                                    "value": 10,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 4,
                "title": "Memory Usage",
                "type": "gauge",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 18,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "(process_resident_memory_bytes{job=\"arthachain-node\"} / 1024 / 1024 / 1024) * 100 / (node_memory_MemTotal_bytes / 1024 / 1024 / 1024)",
                        "legendFormat": "Memory %",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "percent",
                        "min": 0,
                        "max": 100,
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "green"
                                },
                                {
                                    "value": 70,
                                    "color": "yellow"
                                },
                                {
                                    "value": 85,
                                    "color": "red"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 5,
                "title": "CPU Usage",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 4
                },
                "targets": [
                    {
                        "expr": "rate(process_cpu_seconds_total{job=\"arthachain-node\"}[5m]) * 100",
                        "legendFormat": "CPU %",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "percent",
                        "min": 0,
                        "max": 100
                    }
                ]
            },
            {
                "id": 6,
                "title": "Memory Usage Over Time",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 4
                },
                "targets": [
                    {
                        "expr": "process_resident_memory_bytes{job=\"arthachain-node\"} / 1024 / 1024",
                        "legendFormat": "Memory (MB)",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "decmbytes",
                        "min": 0
                    }
                ]
            }
        ]
    },
    "overwrite": true
}